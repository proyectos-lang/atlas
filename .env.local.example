# Supabase — servidor (NUNCA exponer la service role key al cliente)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — cliente, solo para autenticacion
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cadena de conexion directa a Postgres, para migraciones y seed
# Supabase > Project Settings > Database > Connection string > URI
DATABASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Token que protege el Route Handler del cron
CRON_SECRET=
